# MongoDB Atlas connection string for persistent case history.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/mystery-room?retryWrites=true&w=majority

# Create a key in Google AI Studio. Keep it on the server; never use a VITE_ prefix.
GEMINI_API_KEY=your_gemini_api_key

# Optional: defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# The host sets PORT automatically. Set this only for local use.
# PORT=3001
